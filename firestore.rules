rules_version = '2';

// قواعد حماية Firestore — انسخها إلى: Firebase Console > Firestore Database > Rules ثم Publish
service cloud.firestore {
  match /databases/{database}/documents {

    match /students/{studentId} {
      allow read, delete: if signedIn();

      allow create: if signedIn() && validStudent(request.resource.data);

      // An update may not change the duplicate key or creation time. A blind write onto an
      // existing student (e.g. a duplicate import racing another user) counts as an update
      // with a new createdAt, so it is rejected instead of overwriting the record.
      allow update: if signedIn()
        && validStudent(request.resource.data)
        && request.resource.data.dupKey == resource.data.dupKey
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function signedIn() {
      return request.auth != null;
    }

    function validStudent(d) {
      return d.keys().hasOnly(['name', 'department', 'stage', 'studyType', 'totalTuition',
                               'p1', 'r1', 'p2', 'r2', 'p3', 'r3', 'p4', 'r4',
                               'dupKey', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.department is string && d.stage is string && d.studyType is string
        && d.dupKey is string && d.dupKey.size() > 0
        && d.totalTuition is number && d.totalTuition >= 0
        && d.p1 is number && d.p1 >= 0
        && d.p2 is number && d.p2 >= 0
        && d.p3 is number && d.p3 >= 0
        && d.p4 is number && d.p4 >= 0
        && d.r1 is string && d.r2 is string && d.r3 is string && d.r4 is string
        && d.createdAt is timestamp && d.updatedAt is timestamp;
    }
  }
}
